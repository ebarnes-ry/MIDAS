# Default local baseline: Ollama models plus Marker with Gemini support.
MODEL_CONFIG_PROFILE=local
# MIDAS_CONFIG_PATH=src/config/config.hosted-openai.yaml

# Required when MODEL_CONFIG_PROFILE=hosted-openai, or when the selected config
# uses OpenAI for active tasks or Marker LLM annotation.
OPENAI_API_KEY=

# Required for Marker LLM mode when the selected config uses Gemini.
GEMINI_API_KEY=

# Optional hosted-provider keys retained for future profiles/experiments.
GROQ_API_KEY=
